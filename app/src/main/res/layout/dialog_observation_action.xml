<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FCFDF2">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose Action"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#4B5AE4"
        android:fontFamily="@font/nectarine"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnActionEdit"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="EDIT OBSERVATION"
        android:textSize="18sp"
        android:fontFamily="@font/nectarine"
        android:backgroundTint="#4B5AE4"
        android:textColor="#FCFDF2"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        android:layout_marginBottom="12dp"
        android:stateListAnimator="@null"/>

    <Button
        android:id="@+id/btnActionDelete"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="DELETE OBSERVATION"
        android:textSize="18sp"
        android:fontFamily="@font/nectarine"
        android:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        android:stateListAnimator="@null"/>

</LinearLayout>